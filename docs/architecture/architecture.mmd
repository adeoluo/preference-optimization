flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Cli(["CLI<br/>evaluate, compare, serve"]):::edge
        Client(["HTTP client<br/>JSON prompt"]):::edge
        Router["HTTP router<br/>/report, /score"]:::core
        Validate["Validation<br/>prompt index in range"]:::control
        Cli ~~~ Client --> Router --> Validate
    end

    subgraph Core["Alignment pipeline"]
        direction TB
        Pipeline["run_pipeline<br/>beta 0.3, seeds"]:::core
        Teacher["Teacher<br/>demonstrations"]:::core
        Sft["Behavior cloning<br/>penalized MLE"]:::core
        Annotator["Bradley-Terry<br/>preference annotator"]:::core
        Dpo["DPO<br/>exact gradient"]:::core
        Pipeline --> Teacher --> Sft ~~~ Annotator --> Dpo
    end

    subgraph State["Data and state"]
        direction TB
        Domain[("Domain<br/>hidden gold reward")]:::data
        Samples[("Demos and pairs<br/>600 demos, 4800 pairs")]:::data
        Reference[("Reference policy<br/>frozen")]:::data
        Policy[("Aligned policy<br/>log-linear softmax")]:::data
        Domain ~~~ Samples ~~~ Reference ~~~ Policy
    end

    subgraph Obs["Evaluation and outputs"]
        direction TB
        Report["Alignment report<br/>reward gap, win rate"]:::obs
        Diagnostics["Diagnostics<br/>KL, implicit reward"]:::obs
        Score["Per-prompt scores<br/>distributions"]:::obs
        Metrics["/metrics<br/>Prometheus text"]:::obs
        Report ~~~ Diagnostics ~~~ Score ~~~ Metrics
    end

    Interfaces -->|prompt| Core
    Core -->|writes| State
    State -.->|policies| Obs
    Core -->|evaluation| Obs
